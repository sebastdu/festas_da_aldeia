@page
@model IndexModel
@{
    ViewData["Title"] = "Perfil";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="mb-4">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-12">
        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 d-flex gap-2 align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Username" class="form-label-custom">Nome de utilizador</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                        <i class="bi bi-person text-muted"></i>
                    </span>
                    <input asp-for="Username" class="form-control form-control-custom" placeholder="Nome de utilizador" disabled style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0; background-color: #f1f5f9;" />
                </div>
            </div>
            
            <div class="mb-4">
                <label asp-for="Input.PhoneNumber" class="form-label-custom">Número de telefone</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                        <i class="bi bi-telephone text-muted"></i>
                    </span>
                    <input asp-for="Input.PhoneNumber" class="form-control form-control-custom" placeholder="Insira o seu número de telefone" style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                </div>
                <span asp-validation-for="Input.PhoneNumber" class="text-danger small mt-1 d-block"></span>
            </div>
            
            <button id="update-profile-button" type="submit" class="w-100 btn btn-primary py-2 mt-2">
                <i class="bi bi-check-circle me-1"></i> Guardar alterações
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

