@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Eliminar dados pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="mb-4 text-danger">@ViewData["Title"]</h3>

<div class="delete-alert-box" role="alert">
    <i class="bi bi-exclamation-octagon-fill delete-alert-icon"></i>
    <div>
        <h5 class="text-danger mb-1" style="font-weight: 700;">Aviso de segurança</h5>
        <p class="mb-0 small fw-medium">A eliminação destes dados removerá permanentemente a sua conta, e esta ação não poderá ser recuperada.</p>
    </div>
</div>

<div>
    <form id="delete-user" method="post">
        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 d-flex gap-2 align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span></span>
        </div>
        
        @if (Model.RequirePassword)
        {
            <div class="mb-4">
                <label asp-for="Input.Password" class="form-label-custom">Palavra-passe</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Input.Password" class="form-control form-control-custom" autocomplete="current-password" aria-required="true" placeholder="Introduza a sua palavra-passe para confirmar" style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                </div>
                <span asp-validation-for="Input.Password" class="text-danger small mt-1 d-block"></span>
            </div>
        }
        
        <button class="w-100 btn btn-danger-custom py-2 mt-2" type="submit">
            <i class="bi bi-trash-fill me-1"></i> Eliminar dados e fechar a minha conta
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

