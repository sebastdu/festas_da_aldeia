@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Dados pessoais";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h3 class="mb-4">@ViewData["Title"]</h3>

<div class="row">
    <div class="col-md-12">
        <p>A sua conta contém dados pessoais que nos forneceu. Esta página permite descarregar ou eliminar esses dados.</p>
        
        <div class="alert alert-warning mb-4 d-flex gap-2 align-items-center" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-warning"></i>
            <span class="fw-medium text-dark-emphasis small">
                A eliminação destes dados removerá permanentemente a sua conta, e esta ação não poderá ser recuperada.
            </span>
        </div>
        
        <div class="d-flex flex-wrap gap-3 mt-4">
            <form id="download-data" asp-page="DownloadPersonalData" method="post" class="m-0">
                <button class="btn btn-primary py-2" type="submit">
                    <i class="bi bi-download me-1"></i> Descarregar dados
                </button>
            </form>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-danger-custom py-2 text-decoration-none">
                <i class="bi bi-trash me-1"></i> Eliminar conta e dados
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

