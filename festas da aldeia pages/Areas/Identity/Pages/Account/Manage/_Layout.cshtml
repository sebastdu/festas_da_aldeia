@{
    if (ViewData.TryGetValue("ParentLayout", out var parentLayout) && parentLayout != null)
    {
        Layout = parentLayout.ToString();
    }
    else
    {
        Layout = "/Areas/Identity/Pages/_Layout.cshtml";
    }
}

<div class="row justify-content-center">
    <div class="col-lg-10 col-md-12">
        <div class="page-header-container text-center mb-4 border-0">
            <h1 class="page-title-gradient mb-2">
                <i class="bi bi-gear me-2"></i>Gerir a sua conta
            </h1>
            <p class="text-muted mb-0" style="font-size:0.95rem;">Configure os detalhes e definições do seu utilizador</p>
        </div>

        <div class="row mt-4">
            <div class="col-md-3 mb-4">
                <div class="card-custom p-3">
                    <partial name="_ManageNav" />
                </div>
            </div>
            <div class="col-md-9">
                <div class="form-card py-4 px-4 px-sm-5 mt-0">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @RenderSection("Scripts", required: false)
}

