@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Alterar palavra-passe";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<h3 class="mb-4">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<div class="row">
    <div class="col-md-12">
        <form id="change-password-form" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 d-flex gap-2 align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill"></i>
                <span></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Input.OldPassword" class="form-label-custom">Palavra-passe atual</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                        <i class="bi bi-lock text-muted"></i>
                    </span>
                    <input asp-for="Input.OldPassword" class="form-control form-control-custom" autocomplete="current-password" aria-required="true" placeholder="Introduza a sua palavra-passe atual" style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                </div>
                <span asp-validation-for="Input.OldPassword" class="text-danger small mt-1 d-block"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Input.NewPassword" class="form-label-custom">Nova palavra-passe</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                        <i class="bi bi-lock-fill text-muted"></i>
                    </span>
                    <input asp-for="Input.NewPassword" class="form-control form-control-custom" autocomplete="new-password" aria-required="true" placeholder="Mínimo 6 caracteres" style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                </div>
                <span asp-validation-for="Input.NewPassword" class="text-danger small mt-1 d-block"></span>
            </div>
            
            <div class="mb-4">
                <label asp-for="Input.ConfirmPassword" class="form-label-custom">Confirmar nova palavra-passe</label>
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                        <i class="bi bi-shield-lock-fill text-muted"></i>
                    </span>
                    <input asp-for="Input.ConfirmPassword" class="form-control form-control-custom" autocomplete="new-password" aria-required="true" placeholder="Repita a nova palavra-passe" style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                </div>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small mt-1 d-block"></span>
            </div>
            
            <button type="submit" class="w-100 btn btn-primary py-2 mt-2">
                <i class="bi bi-arrow-repeat me-1"></i> Atualizar palavra-passe
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

