@page
@model ErrorModel
@{
    ViewData["Title"] = Model.OriginalStatusCode switch
    {
        404 => "Página Não Encontrada",
        403 => "Acesso Negado",
        _ => "Erro Inesperado"
    };

    var errorIcon = Model.OriginalStatusCode switch
    {
        404 => "bi-exclamation-triangle",
        403 => "bi-shield-slash",
        _ => "bi-bug"
    };

    var errorTitle = Model.OriginalStatusCode switch
    {
        404 => "Erro 404",
        403 => "Erro 403",
        _ => "Erro Inesperado"
    };

    var errorMessage = Model.OriginalStatusCode switch
    {
        404 => "Página não encontrada. A festa ou recurso que procuras não existe.",
        403 => "Acesso negado. Não tens permissões para ver esta página.",
        _ => "Ocorreu um erro inesperado. Estamos a trabalhar para o resolver."
    };
}

<div class="row justify-content-center pt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card card-custom border-0 shadow-lg text-center overflow-hidden">
            <!-- Sleek Top Accent Line with Gradient -->
            <div style="height: 6px; background: var(--primary-gradient);"></div>
            
            <div class="card-body-custom p-5">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10 text-danger mb-4" style="width: 80px; height: 80px;">
                    <i class="bi @errorIcon" style="font-size: 2.5rem;"></i>
                </div>

                <h1 class="page-title-gradient mb-2" style="font-size: 2rem;">@errorTitle</h1>
                <h4 class="fw-semibold text-dark mb-3">Ops! Algo correu mal.</h4>
                
                <div class="alert alert-danger border-0 rounded-3 mb-4 text-center py-3" role="alert" style="font-size: 0.95rem; line-height: 1.5;">
                    @errorMessage
                </div>

                <div class="d-flex flex-column gap-2">
                    <a asp-page="/Index" class="btn btn-primary py-2.5">
                        <i class="bi bi-house-door-fill me-1"></i> Voltar ao Início
                    </a>
                    <a href="javascript:history.back()" class="btn btn-outline-secondary py-2.5">
                        <i class="bi bi-arrow-left me-1"></i> Voltar Atrás
                    </a>
                </div>
            </div>

            @if (Model.ShowRequestId)
            {
                <div class="card-footer bg-light border-0 py-3 text-muted" style="font-size: 0.8rem; font-family: monospace;">
                    ID do Pedido: @Model.RequestId
                </div>
            }
        </div>
    </div>
</div>
