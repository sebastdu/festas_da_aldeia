@{
    var paginaAtual = (int)ViewData["PaginaAtual"]!;
    var totalPaginas = (int)ViewData["TotalPaginas"]!;
    var totalItens = (int)ViewData["TotalItens"]!;
    var baseRoute = (Dictionary<string, string>)ViewData["RouteValues"]!;

    if (totalPaginas == 0) totalPaginas = 1;

    int inicio = Math.Max(1, paginaAtual - 2);
    int fim = Math.Min(totalPaginas, paginaAtual + 2);

    Dictionary<string, string> R(int p)
    {
        var d = new Dictionary<string, string>(baseRoute);
        d["Pagina"] = p.ToString();
        return d;
    }
}

<div class="paginacao-wrapper">
    <p class="paginacao-info">
        Página <strong>@paginaAtual</strong> de <strong>@totalPaginas</strong>
        · @totalItens item@(totalItens != 1 ? "s" : "")
    </p>

    <nav class="paginacao-nav" aria-label="Paginação">

        @* Anterior *@
        @if (paginaAtual > 1)
        {
            <a asp-all-route-data="@R(paginaAtual - 1)" class="paginacao-btn paginacao-prev">
                <i class="bi bi-chevron-left me-1"></i> Anterior
            </a>
        }
        else
        {
            <span class="paginacao-btn paginacao-prev disabled">
                <i class="bi bi-chevron-left me-1"></i> Anterior
            </span>
        }

        @* Primeira página *@
        @if (inicio > 1)
        {
            <a asp-all-route-data="@R(1)" class="paginacao-btn">1</a>
            if (inicio > 2)
            {

                <span class="paginacao-sep">…</span>
            }
        }

        @* Páginas centrais *@
        @for (int p = inicio; p <= fim; p++)
        {
            <a asp-all-route-data="@R(p)" class="paginacao-btn @(p == paginaAtual ? "ativo" : "")">@p</a>
        }

        @* Última página *@
        @if (fim < totalPaginas)
        {
            if (fim < totalPaginas - 1)
            {
                <span class="paginacao-sep">…</span>
            }
            <a asp-all-route-data="@R(totalPaginas)" class="paginacao-btn">@totalPaginas</a>
        }

        @* Próxima *@
        @if (paginaAtual < totalPaginas)
        {
            <a asp-all-route-data="@R(paginaAtual + 1)" class="paginacao-btn paginacao-next">
                Seguinte <i class="bi bi-chevron-right ms-1"></i>
            </a>
        }
        else
        {
            <span class="paginacao-btn paginacao-next disabled">
                Seguinte <i class="bi bi-chevron-right ms-1"></i>
            </span>
        }
    </nav>
</div>
