<!DOCTYPE html>
<html lang="pt">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Festas da Aldeia</title>
    
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/festas_da_aldeia_pages.styles.css" asp-append-version="true" />
</head>
<body>
    <header class="sticky-top">
        <nav class="navbar navbar-expand-sm navbar-dark navbar-custom border-bottom box-shadow">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-page="/Index">
                    <img src="~/imagens/RallyFestas_logo_nobg.png" alt="Logo Festas da Aldeia" class="me-3" style="height: 40px;">
                    <span class="fw-bold tracking-tight">RallyFestas</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 nav-links-custom ms-lg-4">

                        @* ── INÍCIO ── *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">
                                <i class="bi bi-house-door me-1"></i> Início
                            </a>
                        </li>

                        @* ── ARTISTAS ── *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/ArtistaPages/Index">
                                <i class="bi bi-people me-1"></i> Artistas
                            </a>
                        </li>

                        @* ── EVENTOS ── *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/EventoPages/ClienteLista">
                                <i class="bi bi-calendar-event me-1"></i> Eventos
                            </a>
                        </li>

                        @* ── LOCAIS ── *@
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/LocalPages/ListaLocais">
                                <i class="bi bi-geo-alt me-1"></i> Locais
                            </a>
                        </li>

                        @* ── GESTÃO (apenas Admin) — dropdown ── *@
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button"
                                   data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-shield-lock me-1"></i> Gestão
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark navbar-dropdown-custom">
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-page="/ArtistaPages/Admin">
                                            <i class="bi bi-people me-2"></i>Artistas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-page="/CartazPages/Index">
                                            <i class="bi bi-file-music me-2"></i>Cartazes
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-page="/EventoPages/Index">
                                            <i class="bi bi-calendar-event me-2"></i>Eventos
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-area="" asp-page="/LocalPages/Index">
                                            <i class="bi bi-geo-alt me-2"></i>Locais
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }

                    </ul>
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container main-content-container">
        <main role="main" class="pb-5 pt-4">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer-custom py-4 mt-auto">
        <div class="container">
            <div class="row gy-4 mb-4 text-start">
                <!-- Coluna 1: Institucional -->
                <div class="col-md-4">
                    <h6 class="text-uppercase fw-bold text-white mb-3">Identificação Institucional</h6>
                    <p class="mb-1 text-white" style="font-size: 0.9rem;">Instituto Politécnico de Tomar</p>
                    <p class="mb-1 text-white" style="font-size: 0.9rem;">Curso: Engenharia Informática</p>
                    <p class="mb-0 text-white" style="font-size: 0.9rem;">Disciplina: Desenvolvimento Web</p>
                </div>
                <!-- Coluna 2: Equipa -->
                <div class="col-md-4">
                    <h6 class="text-uppercase fw-bold text-white mb-3">Grupo</h6>
                    <ul class="list-unstyled mb-0 text-white" style="font-size: 0.9rem;">
                        <li class="mb-2 d-flex align-items-center">
                            <span class="badge bg-secondary me-2" style="font-size: 0.75rem;">24269</span>
                            <span>José Orlando Lourenço Martins</span>
                        </li>
                        <li class="d-flex align-items-center">
                            <span class="badge bg-secondary me-2" style="font-size: 0.75rem;">23027</span>
                            <span>Sebastião de Oliveira Duarte</span>
                        </li>
                    </ul>
                </div>
                <!-- Coluna 3: Credenciais -->
                <div class="col-md-4">
                    <h6 class="text-uppercase fw-bold text-white mb-3">Credenciais de Teste</h6>
                    <ul class="list-unstyled mb-0 text-white" style="font-size: 0.85rem; line-height: 1.8;">
                        <li class="mb-2">
                            <strong class="text-white">Admin:</strong> 
                            <code class="px-1 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; font-family: monospace;">admin@festas.com</code>
                            <br/><span class="ms-4 text-white">Senha: <code class="px-1 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; font-family: monospace;">123Qwe##</code></span>
                        </li>
                        <li>
                            <strong class="text-white">Cliente:</strong> 
                            <code class="px-1 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; font-family: monospace;">cliente@festas.com</code>
                            <br/><span class="ms-4 text-white">Senha: <code class="px-1 rounded" style="background: rgba(0,0,0,0.3); border: 1px solid rgba(255,255,255,0.1); color: #e2e8f0; font-family: monospace;">123Qwe##</code></span>
                        </li>
                    </ul>
                </div>
            </div>
            
            <hr class="border-secondary my-3" style="opacity: 0.15;" />
            
            <div class="row align-items-center">
                <!-- Recursos Externos (Centralizado) -->
                <div class="col-12 text-center mb-2">
                    <small class="text-white">
                        Recursos externos utilizados: 
                        <a href="https://fonts.google.com/specimen/Plus+Jakarta+Sans" target="_blank" rel="noopener" class="text-decoration-none ms-1 me-2"><i class="bi bi-fonts me-1"></i>Plus Jakarta Sans</a>
                        |
                        <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener" class="text-decoration-none ms-2"><i class="bi bi-bootstrap me-1"></i>Bootstrap Icons</a>
                    </small>
                </div>
                <!-- Direitos & Privacidade -->
                <div class="col-12 text-center">
                    <small class="text-white">
                        &copy; 2026 - RallyFestas. Todos os direitos reservados.
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
