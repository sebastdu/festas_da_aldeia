@page
@model IndexModel
@using System.Text.Json
@{
    ViewData["Title"] = "Início - RallyFestas";
}

<!-- Hero Banner Section -->
<div class="position-relative overflow-hidden rounded-4 mb-5 shadow-lg" 
     style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.92), rgba(79, 70, 229, 0.35)), url('/imagens/banner.png') no-repeat center center; background-size: cover; min-height: 400px; display: flex; align-items: center;">
    <div class="container p-4 p-md-5 text-white">
        <div class="row align-items-center">
            <div class="col-lg-8 text-center text-lg-start">
                <h1 class="display-3 fw-extrabold mb-3 tracking-tight text-white leading-none">
                    Bem-vindo ao <span class="text-primary-gradient" style="background: linear-gradient(90deg, #818cf8, #38bdf8); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">RallyFestas</span>
                </h1>
                <p class="lead text-white-50 fs-5 mb-4 max-w-xl mx-auto mx-lg-0">
                    Arranca para a tradição! Faz o teu rally por recintos, palcos e tasquinhas. Atesta o convívio com música ao vivo e gastronomia local, e planeia já a tua próxima etapa.
                </p>
                <div class="d-flex flex-column flex-sm-row justify-content-center justify-content-lg-start gap-3">
                    <a asp-page="/EventoPages/index" class="btn btn-primary btn-lg px-4 py-3 shadow">
                        <i class="bi bi-calendar-event"></i> Ver Agenda Completa
                    </a>
                    <a asp-page="/LocalPages/index" class="btn btn-outline-light btn-lg px-4 py-3">
                        <i class="bi bi-geo-alt"></i> Explorar Recintos
                    </a>
                </div>
            </div>
            <div class="col-lg-4 d-none d-lg-block text-center">
                <img src="/imagens/RallyFestas_logo_nobg.png" alt="RallyFestas Logo" class="img-fluid floating-logo" style="max-height: 250px; filter: drop-shadow(0 10px 25px rgba(99, 102, 241, 0.4));">
            </div>
        </div>
    </div>
</div>

<!-- Stats Counter Grid Section -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card card-custom h-100 text-center py-4 border-0 shadow-sm" style="background: linear-gradient(to bottom, #ffffff, #f8fafc);">
            <div class="card-body-custom d-flex flex-column align-items-center">
                <div class="card-icon-container bg-primary-subtle text-primary border rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-people-fill fs-3"></i>
                </div>
                <h2 class="display-5 fw-extrabold text-dark mb-1">@Model.TotalArtistas</h2>
                <p class="text-muted fw-semibold uppercase tracking-wider small mb-0">Artistas Confirmados</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom h-100 text-center py-4 border-0 shadow-sm" style="background: linear-gradient(to bottom, #ffffff, #f8fafc);">
            <div class="card-body-custom d-flex flex-column align-items-center">
                <div class="card-icon-container bg-success-subtle text-success border rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-calendar-check-fill fs-3"></i>
                </div>
                <h2 class="display-5 fw-extrabold text-dark mb-1">@Model.TotalEventos</h2>
                <p class="text-muted fw-semibold uppercase tracking-wider small mb-0">Eventos na Agenda</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card card-custom h-100 text-center py-4 border-0 shadow-sm" style="background: linear-gradient(to bottom, #ffffff, #f8fafc);">
            <div class="card-body-custom d-flex flex-column align-items-center">
                <div class="card-icon-container bg-info-subtle text-info border rounded-circle mb-3" style="width: 60px; height: 60px;">
                    <i class="bi bi-geo-alt-fill fs-3"></i>
                </div>
                <h2 class="display-5 fw-extrabold text-dark mb-1">@Model.TotalLocais</h2>
                <p class="text-muted fw-semibold uppercase tracking-wider small mb-0">Recintos & Palcos</p>
            </div>
        </div>
    </div>
</div>

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<!-- Map Section -->
<div class="card card-custom mb-5 shadow-sm border-0">
    <div class="card-body-custom p-4">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
            <div>
                <h2 class="fw-extrabold text-dark mb-1">
                    <i class="bi bi-map me-2 text-primary"></i>RallyMapa das Festas
                </h2>
                <p class="text-muted mb-0 small">Encontra os recintos e vê onde estão a decorrer as festividades da aldeia.</p>
            </div>
        </div>

        <!-- Control Panel for Filters -->
        <div class="row g-3 mb-4 align-items-end map-controls-panel p-3 rounded-3 mx-0">
            <!-- Geolocalização -->
            <div class="col-lg-3 col-md-4">
                <label class="form-label-custom mb-2 small text-muted">
                    <i class="bi bi-compass me-1"></i>Posicionamento
                </label>
                <button id="btn-geolocation" class="btn btn-primary shadow-sm w-100 py-2">
                    <i class="bi bi-geo-alt-fill"></i> Obter Localização
                </button>
            </div>
            
            <!-- Slider de Raio de Distância -->
            <div class="col-lg-4 col-md-8" id="radius-control-container" style="opacity: 0.5; pointer-events: none; transition: opacity var(--transition-normal);">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label for="radius-slider" class="form-label-custom mb-0 small text-muted">
                        <i class="bi bi-broadcast text-primary me-1"></i>Raio de Proximidade
                    </label>
                    <span id="radius-badge" class="badge-custom badge-duration py-1 px-2 m-0">15 km</span>
                </div>
                <input type="range" class="form-range custom-slider" id="radius-slider" min="1" max="50" value="15" disabled>
            </div>
            
            <!-- Filtro de Estado do Evento -->
            <div class="col-lg-5 col-md-12">
                <div class="d-flex flex-column">
                    <label class="form-label-custom mb-2 small text-muted">
                        <i class="bi bi-funnel-fill text-secondary me-1"></i>Estado das Festas
                    </label>
                    <div class="btn-group w-100" role="group" aria-label="Filtro de tempo">
                        <input type="radio" class="btn-check" name="filter-time" id="btnradio-all" autocomplete="off" checked value="todos">
                        <label class="btn btn-outline-primary btn-sm py-2" for="btnradio-all">Todas</label>

                        <input type="radio" class="btn-check" name="filter-time" id="btnradio-now" autocomplete="off" value="decorrer">
                        <label class="btn btn-outline-success btn-sm py-2" for="btnradio-now">
                            <span class="d-inline-block rounded-circle bg-success me-1 animate-pulse" style="width: 8px; height: 8px;"></span>A Decorrer
                        </label>

                        <input type="radio" class="btn-check" name="filter-time" id="btnradio-soon" autocomplete="off" value="brevemente">
                        <label class="btn btn-outline-primary btn-sm py-2" for="btnradio-soon">Brevemente</label>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Map Container -->
        <div class="position-relative rounded-3 overflow-hidden border" style="height: 450px; background-color: #e2e8f0; z-index: 1;">
            <div id="map" style="height: 100%; width: 100%;"></div>
            
            <!-- Notice overlay if geolocation status changes -->
            <div id="map-notice" class="position-absolute bottom-0 start-0 m-3 p-2 bg-white rounded shadow-sm d-none" style="z-index: 1000; max-width: 280px; font-size: 0.85rem; border: 1px solid var(--border-light);">
                <span class="text-secondary"><i class="bi bi-info-circle me-1 text-primary"></i> <span id="map-notice-text"></span></span>
            </div>
        </div>
    </div>
</div>

<!-- Main Highlights Content (2 Columns Grid) -->
<div class="row g-5">
    
    <!-- Left Column: Upcoming Events -->
    <div class="col-lg-7">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-extrabold text-dark mb-1"><i class="bi bi-calendar-event me-2 text-primary"></i>Hoje e Brevemente</h2>
                <p class="text-muted mb-0 small">Os próximos espetáculos imperdíveis na aldeia.</p>
            </div>
            <a asp-page="/EventoPages/ClienteLista" class="text-decoration-none fw-bold small back-link">
                Ver Todos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        
        @if (!Model.EventosProximos.Any())
        {
            <div class="card-custom text-center py-5 border-dashed" id="events-no-db-empty-state">
                <div class="card-body-custom">
                    <i class="bi bi-calendar-x fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="fw-bold">Sem eventos futuros agendados</h5>
                    <p class="text-muted small">Por favor, volte mais tarde para consultar novas atualizações.</p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-4" id="events-list-container">
                @foreach (var ev in Model.EventosProximos)
                {
                    string lat = "";
                    string lng = "";
                    if (ev.Local != null && !string.IsNullOrEmpty(ev.Local.Coordenadas))
                    {
                        var coords = ev.Local.Coordenadas.Split(',');
                        if (coords.Length == 2)
                        {
                            lat = coords[0].Trim();
                            lng = coords[1].Trim();
                        }
                    }
                    <div class="card card-custom border-light-subtle shadow-sm transition-all hover-translate-y event-card"
                         data-lat="@lat"
                         data-lng="@lng"
                         data-inicio="@ev.DataInicio.ToString("yyyy-MM-ddTHH:mm:ss")"
                         data-fim="@ev.DataFim.ToString("yyyy-MM-ddTHH:mm:ss")">
                        <div class="card-body-custom p-4">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div>
                                    <h4 class="fw-bold mb-1">@ev.Nome</h4>
                                    <span class="small text-muted">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i>
                                        @if (ev.Local != null)
                                        {
                                            <strong class="text-dark">@ev.Local.Nome</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">Sem Local definido</span>
                                        }
                                    </span>
                                </div>
                                <span class="badge bg-light text-dark border py-2 px-3 rounded-pill fw-semibold small">
                                    <i class="bi bi-clock me-1 text-warning"></i>
                                    @ev.DataInicio.ToString("HH:mm")
                                </span>
                            </div>
                            
                            @if (!string.IsNullOrEmpty(ev.Descricao))
                            {
                                <p class="text-muted small mb-3">@ev.Descricao</p>
                            }
                            
                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <span class="badge-custom badge-duration text-dark fw-semibold">
                                    <i class="bi bi-calendar3 text-primary"></i>
                                    @ev.DataInicio.ToString("dd 'de' MMMM")
                                </span>
                                <a asp-page="/EventoPages/Details" asp-route-id="@ev.IdEvento" class="btn btn-outline-primary btn-sm px-3">
                                    Ver Alinhamento <i class="bi bi-chevron-right small"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Empty state shown via JS if filters result in 0 visible cards -->
                <div class="card-custom text-center py-5 border-dashed d-none" id="events-filter-empty-state">
                    <div class="card-body-custom">
                        <i class="bi bi-funnel fs-1 text-muted mb-3 d-block"></i>
                        <h5 class="fw-bold">Nenhum evento corresponde aos filtros</h5>
                        <p class="text-muted small">Tente aumentar o raio de pesquisa ou alterar o filtro de tempo.</p>
                    </div>
                </div>
            </div>
        }
    </div>
    
    <!-- Right Column: Recintos & Palcos -->
    <div class="col-lg-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="fw-extrabold text-dark mb-1"><i class="bi bi-geo-alt me-2 text-success"></i>Explorar Recintos</h2>
                <p class="text-muted mb-0 small">Onde a magia e a festa acontecem.</p>
            </div>
            <a asp-page="/LocalPages/index" class="text-decoration-none fw-bold small back-link">
                Ver Todos <i class="bi bi-arrow-right"></i>
            </a>
        </div>
        
        @if (!Model.LocaisPrincipais.Any())
        {
            <div class="card-custom text-center py-5 border-dashed">
                <div class="card-body-custom">
                    <i class="bi bi-geo-alt fs-1 text-muted mb-3 d-block"></i>
                    <h5 class="fw-bold">Nenhum recinto registado</h5>
                    <p class="text-muted small">Os palcos e recintos serão anunciados em breve.</p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var loc in Model.LocaisPrincipais)
                {
                    <div class="card card-custom shadow-sm">
                        <div class="card-body-custom p-3">
                            <div class="d-flex align-items-center gap-3">
                                <div class="card-icon-container bg-light border m-0" style="width: 48px; height: 48px; flex-shrink: 0;">
                                    @if (loc.Outside)
                                    {
                                        <i class="bi bi-tree-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-house-door-fill text-primary"></i>
                                    }
                                </div>
                                <div class="flex-grow-1 min-w-0">
                                    <h5 class="fw-bold text-truncate mb-1">@loc.Nome</h5>
                                    <span class="badge-custom @(loc.Outside ? "badge-outdoor" : "badge-indoor") py-1 px-2">
                                        @(loc.Outside ? "Exterior" : "Interior")
                                    </span>
                                </div>
                                <div>
                                    <a asp-page="/LocalPages/Details" asp-route-id="@loc.IdLocal" class="btn btn-action-sm details" title="Ver Detalhes">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    <style>
/* Micro-animation for floating logo in hero banner */
.floating-logo {
    animation: float 4s ease-in-out infinite;
}

@@keyframes float {
    0% { transform: translateY(0px); }
    50% { transform: translateY(-8px); }
    100% { transform: translateY(0px); }
}

.border-dashed {
    border: 2px dashed var(--border-light) !important;
    background: transparent !important;
}

.transition-all {
    transition: all var(--transition-normal);
}

.hover-translate-y:hover {
    transform: translateY(-2px);
}

/* Leaflet map improvements to match page style */
#map {
    z-index: 10;
}
.leaflet-popup-content-wrapper {
    border-radius: var(--radius-md) !important;
    box-shadow: var(--shadow-lg) !important;
    border: 1px solid var(--border-light) !important;
}
.leaflet-popup-tip {
    box-shadow: var(--shadow-sm) !important;
}
.leaflet-popup-content {
    font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif !important;
    color: var(--text-main) !important;
    margin: 12px 16px !important;
}
.leaflet-popup-content h6 {
    font-size: 0.95rem;
}
.spinner-border-sm {
    width: 1rem;
    height: 1rem;
    border-width: 0.15em;
}

/* Premium styling for filters */
.map-controls-panel {
    background: rgba(255, 255, 255, 0.7);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border: 1px solid var(--border-light);
    box-shadow: var(--shadow-sm);
    transition: var(--transition-normal);
}

.custom-slider {
    height: 6px;
    background-color: var(--border-light);
    border-radius: var(--radius-full);
    outline: none;
}

.custom-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--primary-color);
    cursor: pointer;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
}

.custom-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
    background: #4f46e5;
}

.custom-slider::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: none;
    border-radius: 50%;
    background: var(--primary-color);
    cursor: pointer;
    box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.2);
    transition: transform var(--transition-fast), background-color var(--transition-fast);
}

.custom-slider::-moz-range-thumb:hover {
    transform: scale(1.2);
    background: #4f46e5;
}

.animate-pulse {
    animation: pulse 1.8s cubic-bezier(0.4, 0, 0.6, 1) infinite;
}

@@keyframes pulse {
    0%, 100% {
        opacity: 1;
        transform: scale(1);
    }
    50% {
        opacity: .4;
        transform: scale(1.1);
    }
}

.animate-fade-in {
    animation: fadeIn 0.35s cubic-bezier(0.4, 0, 0.2, 1);
}

@@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>

@section Scripts {
    <!-- Leaflet JS -->
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    
    <script>
        // Dados dos eventos vindos do servidor
        const mapEvents = @Html.Raw(JsonSerializer.Serialize(Model.EventosMapa));
        
        document.addEventListener("DOMContentLoaded", function () {
            let defaultLat = 39.6030;
            let defaultLng = -8.4164;
            let hasEvents = false;
            
            // Filtrar eventos válidos que tenham latitude e longitude válidas
            const validEvents = [];
            let latSum = 0;
            let lngSum = 0;
            
            if (mapEvents && mapEvents.length > 0) {
                mapEvents.forEach(e => {
                    if (e.Coordenadas) {
                        const parts = e.Coordenadas.split(',');
                        if (parts.length === 2) {
                            const lat = parseFloat(parts[0]);
                            const lng = parseFloat(parts[1]);
                            if (!isNaN(lat) && !isNaN(lng)) {
                                validEvents.push({
                                    ...e,
                                    lat: lat,
                                    lng: lng
                                });
                                latSum += lat;
                                lngSum += lng;
                            }
                        }
                    }
                });
            }
            
            if (validEvents.length > 0) {
                defaultLat = latSum / validEvents.length;
                defaultLng = lngSum / validEvents.length;
                hasEvents = true;
            }
            
            // Criar mapa
            const map = L.map('map').setView([defaultLat, defaultLng], hasEvents ? 14 : 8);
            
            // Adicionar tile layer do OpenStreetMap (Mapnik)
            L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
            }).addTo(map);
            
            // Criar icons personalizados
            // Icon azul para o utilizador
            const userIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-blue.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
            
            // Icon vermelho para eventos
            const eventIcon = L.icon({
                iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-2x-red.png',
                shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.7.1/images/marker-shadow.png',
                iconSize: [25, 41],
                iconAnchor: [12, 41],
                popupAnchor: [1, -34],
                shadowSize: [41, 41]
            });
            
            // Adicionar marcadores dos eventos
            const markerObjects = [];
            validEvents.forEach(e => {
                const popupContent = `
                    <div style="min-width: 180px;">
                        <h6 class="fw-bold mb-1 text-primary" style="margin: 0 0 4px 0;">${e.Nome}</h6>
                        <p class="text-muted small mb-2" style="margin: 0 0 8px 0; font-size: 0.8rem;">
                            <i class="bi bi-geo-alt-fill text-danger me-1"></i>${e.LocalNome} (${e.IsOutside ? 'Exterior' : 'Interior'})
                        </p>
                        <p class="small mb-2 text-dark" style="margin: 0 0 8px 0; font-size: 0.85rem; line-height: 1.3;">
                            ${e.Descricao ? e.Descricao : 'Sem descrição adicional.'}
                        </p>
                        <div class="border-top pt-2" style="font-size: 0.75rem; border-top: 1px solid var(--border-light); margin-top: 6px;">
                            <div class="text-secondary"><i class="bi bi-calendar-event me-1 text-primary"></i>Início: ${formatarData(e.DataInicio)}</div>
                            <div class="text-secondary"><i class="bi bi-calendar-check me-1 text-success"></i>Fim: ${formatarData(e.DataFim)}</div>
                            <div class="mt-2 text-center">
                                <a href="/EventoPages/Details?id=${e.IdEvento}" class="btn btn-outline-primary btn-sm w-100 py-1" style="font-size: 0.75rem; padding: 2px 8px; justify-content: center; gap: 4px;">
                                    Detalhes <i class="bi bi-chevron-right small"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                `;
                
                const marker = L.marker([e.lat, e.lng], { icon: eventIcon })
                    .bindPopup(popupContent)
                    .addTo(map);
                    
                markerObjects.push({
                    marker: marker,
                    data: e
                });
            });
            
            // Se houver múltiplos eventos, ajustar a visualização do mapa para englobar todos eles
            if (validEvents.length > 1) {
                const group = new L.featureGroup(markerObjects.map(o => o.marker));
                map.fitBounds(group.getBounds().pad(0.15));
            } else if (validEvents.length === 1) {
                map.setView([validEvents[0].lat, validEvents[0].lng], 15);
            }
            
            // Variável para guardar o posicionamento do utilizador
            let userLocation = null;
            let userMarker = null;
            let userAccuracyCircle = null;
            let userSearchCircle = null;
            
            // Configurar geolocalização do utilizador
            const btnGeo = document.getElementById('btn-geolocation');
            const radiusSlider = document.getElementById('radius-slider');
            const radiusBadge = document.getElementById('radius-badge');
            const radiusControlContainer = document.getElementById('radius-control-container');
            const timeRadios = document.querySelectorAll('input[name="filter-time"]');
            const eventCards = document.querySelectorAll('.event-card');
            const emptyState = document.getElementById('events-filter-empty-state');
            const mapNotice = document.getElementById('map-notice');
            const mapNoticeText = document.getElementById('map-notice-text');
            
            function showNotice(msg) {
                mapNoticeText.textContent = msg;
                mapNotice.classList.remove('d-none');
            }
            
            // Fórmula de Haversine em Javascript
            function calcularDistanciaKm(lat1, lon1, lat2, lon2) {
                const R = 6371; // Raio da Terra em km
                const dLat = (lat2 - lat1) * Math.PI / 180;
                const dLon = (lon2 - lon1) * Math.PI / 180;
                const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                          Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                          Math.sin(dLon / 2) * Math.sin(dLon / 2);
                const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
                return R * c;
            }
            
            // Lógica de Filtragem Unificada
            function applyFilters() {
                const radiusVal = parseFloat(radiusSlider.value);
                const selectedTimeElement = document.querySelector('input[name="filter-time"]:checked');
                const selectedTime = selectedTimeElement ? selectedTimeElement.value : 'todos';
                const now = new Date();
                
                // Atualizar o badge do raio
                radiusBadge.textContent = `${radiusVal} km`;
                
                // 1. Filtrar marcadores no mapa
                markerObjects.forEach(item => {
                    let isVisible = true;
                    
                    // Filtragem por distância (apenas se geolocalizado)
                    if (userLocation) {
                        const dist = calcularDistanciaKm(userLocation.lat, userLocation.lng, item.data.lat, item.data.lng);
                        if (dist > radiusVal) {
                            isVisible = false;
                        }
                    }
                    
                    // Filtragem por estado temporal
                    if (isVisible) {
                        const dataInicio = new Date(item.data.DataInicio);
                        const dataFim = new Date(item.data.DataFim);
                        
                        if (selectedTime === 'decorrer') {
                            if (now < dataInicio || now > dataFim) {
                                isVisible = false;
                            }
                        } else if (selectedTime === 'brevemente') {
                            if (dataInicio <= now) {
                                isVisible = false;
                            }
                        } else { // 'todos' (esconder passados por padrão para manter limpo)
                            if (dataFim < now) {
                                isVisible = false;
                            }
                        }
                    }
                    
                    // Aplicar visibilidade ao marcador do mapa
                    if (isVisible) {
                        if (!map.hasLayer(item.marker)) {
                            map.addLayer(item.marker);
                        }
                    } else {
                        if (map.hasLayer(item.marker)) {
                            map.removeLayer(item.marker);
                        }
                    }
                });
                
                // 2. Filtrar cards de eventos listados
                let visibleCardsCount = 0;
                eventCards.forEach(card => {
                    const latAttr = card.getAttribute('data-lat');
                    const lngAttr = card.getAttribute('data-lng');
                    const lat = parseFloat(latAttr);
                    const lng = parseFloat(lngAttr);
                    const inicioStr = card.getAttribute('data-inicio');
                    const fimStr = card.getAttribute('data-fim');
                    
                    let isVisible = true;
                    
                    // Filtragem por distância (apenas se geolocalizado)
                    if (userLocation) {
                        if (!isNaN(lat) && !isNaN(lng)) {
                            const dist = calcularDistanciaKm(userLocation.lat, userLocation.lng, lat, lng);
                            if (dist > radiusVal) {
                                isVisible = false;
                            }
                        } else {
                            // Se estiver geolocalizado e o evento não tiver coordenadas, ocultamos
                            isVisible = false;
                        }
                    }
                    
                    // Filtragem por estado temporal
                    if (isVisible && inicioStr && fimStr) {
                        const dataInicio = new Date(inicioStr);
                        const dataFim = new Date(fimStr);
                        
                        if (selectedTime === 'decorrer') {
                            if (now < dataInicio || now > dataFim) {
                                isVisible = false;
                            }
                        } else if (selectedTime === 'brevemente') {
                            if (dataInicio <= now) {
                                isVisible = false;
                            }
                        } else { // 'todos'
                            if (dataFim < now) {
                                isVisible = false;
                            }
                        }
                    }
                    
                    // Aplicar visibilidade ao card de HTML
                    if (isVisible) {
                        card.style.display = 'block';
                        card.classList.remove('d-none');
                        visibleCardsCount++;
                    } else {
                        card.style.display = 'none';
                        card.classList.add('d-none');
                    }
                });
                
                // Show empty state if no events are visible
                if (emptyState) {
                    if (visibleCardsCount === 0) {
                        emptyState.classList.remove('d-none');
                    } else {
                        emptyState.classList.add('d-none');
                    }
                }
            }
            
            // Ouvintes de eventos nos controlos de filtro
            radiusSlider.addEventListener('input', function () {
                const radiusVal = parseFloat(radiusSlider.value);
                if (userSearchCircle && userLocation) {
                    userSearchCircle.setRadius(radiusVal * 1000);
                }
                applyFilters();
            });
            
            timeRadios.forEach(radio => {
                radio.addEventListener('change', applyFilters);
            });
            
            // Tratar Clique do Botão de Geolocalização
            btnGeo.addEventListener('click', function () {
                btnGeo.disabled = true;
                const originalText = btnGeo.innerHTML;
                btnGeo.innerHTML = `<span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span> A obter...`;
                
                if (!navigator.geolocation) {
                    showNotice("A geolocalização não é suportada por este navegador.");
                    btnGeo.innerHTML = originalText;
                    btnGeo.disabled = false;
                    return;
                }
                
                navigator.geolocation.getCurrentPosition(
                    function (position) {
                        const userLat = position.coords.latitude;
                        const userLng = position.coords.longitude;
                        const accuracy = position.coords.accuracy;
                        
                        userLocation = { lat: userLat, lng: userLng };
                        
                        // Ativar controlos do slider de raio
                        radiusSlider.removeAttribute('disabled');
                        radiusControlContainer.style.opacity = '1';
                        radiusControlContainer.style.pointerEvents = 'auto';
                        
                        // Remover elementos anteriores do mapa
                        if (userMarker) {
                            map.removeLayer(userMarker);
                        }
                        if (userAccuracyCircle) {
                            map.removeLayer(userAccuracyCircle);
                        }
                        if (userSearchCircle) {
                            map.removeLayer(userSearchCircle);
                        }
                        
                        // Adicionar círculo de precisão
                        userAccuracyCircle = L.circle([userLat, userLng], {
                            radius: accuracy,
                            color: '#3b82f6',
                            fillColor: '#3b82f6',
                            fillOpacity: 0.15,
                            weight: 1
                        }).addTo(map);
                        
                        // Adicionar círculo dinâmico de raio de pesquisa
                        const radiusVal = parseFloat(radiusSlider.value);
                        userSearchCircle = L.circle([userLat, userLng], {
                            radius: radiusVal * 1000,
                            color: '#4f46e5',
                            fillColor: '#6366f1',
                            fillOpacity: 0.08,
                            weight: 2,
                            dashArray: '5, 5'
                        }).addTo(map);
                        
                        // Adicionar marcador do utilizador
                        userMarker = L.marker([userLat, userLng], { icon: userIcon })
                            .bindPopup(`
                                <div style="min-width: 140px; text-align: center;">
                                    <h6 class="fw-bold mb-1 text-primary"><i class="bi bi-person-fill me-1"></i>A tua localização</h6>
                                    <p class="text-muted small mb-0" style="font-size: 0.75rem;">Precisão: ~${Math.round(accuracy)} metros</p>
                                </div>
                            `)
                            .addTo(map);
                            
                        // Centrar mapa na localização do utilizador e ajustar zoom
                        map.setView([userLat, userLng], 13);
                        
                        btnGeo.innerHTML = `<i class="bi bi-geo-alt-fill"></i> Localização Atualizada`;
                        btnGeo.disabled = false;
                        btnGeo.classList.remove('btn-primary');
                        btnGeo.classList.add('btn-success');
                        
                        showNotice("Localização obtida com sucesso!");
                        
                        // Aplicar a filtragem com as novas coordenadas
                        applyFilters();
                    },
                    function (error) {
                        console.error(error);
                        let errMsg = "Não foi possível obter a sua localização.";
                        switch (error.code) {
                            case error.PERMISSION_DENIED:
                                errMsg = "Permissão de geolocalização rejeitada pelo utilizador.";
                                break;
                            case error.POSITION_UNAVAILABLE:
                                errMsg = "A informação de localização está indisponível.";
                                break;
                            case error.TIMEOUT:
                                errMsg = "Tempo limite atingido ao obter localização.";
                                break;
                        }
                        showNotice(errMsg);
                        btnGeo.innerHTML = originalText;
                        btnGeo.disabled = false;
                    },
                    {
                        enableHighAccuracy: true,
                        timeout: 10000,
                        maximumAge: 0
                    }
                );
            });
            
            // Função auxiliar para formatar data ISO em formato legível português
            function formatarData(isoString) {
                if (!isoString) return "";
                const data = new Date(isoString);
                return data.toLocaleDateString('pt-PT', { 
                    day: '2-digit', 
                    month: 'short',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }
            
            // Inicializar filtros para limpar eventos passados no primeiro carregamento
            applyFilters();
        });
    </script>
}

