@page
@model festas_da_aldeia_pages.Pages.LocalPages.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Local</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Local.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Local.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Local.Descricao)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Local.Descricao)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Local.Outside)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Local.Outside)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Local.Coordenadas)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Local.Coordenadas)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Local.Eventos)
        </dt>
        <dd class = "col-sm-10">
            @if (Model.Local.Eventos != null && Model.Local.Eventos.Any())
            {
                <ul>
                    @foreach (var evento in Model.Local.Eventos)
                    {
                        <li>@evento.Nome</li>
                    }
                </ul>
            }
            else
            {
                <span class="text-muted">Sem eventos associados</span>
            }
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Local.IdLocal">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
