@page
@model festas_da_aldeia_pages.Pages.LocalPages.CreateModel

@{
    ViewData["Title"] = "Criar Local";
}

<h1>Criar</h1>

<h4>Local</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Local.Nome" class="control-label"></label>
                <input asp-for="Local.Nome" class="form-control" aria-required="true" />
                <span asp-validation-for="Local.Nome" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Local.Descricao" class="control-label"></label>
                <textarea asp-for="Local.Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Local.Descricao" class="text-danger"></span>
            </div>

            <div class="form-group form-check mt-3 mb-3">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Local.Outside" /> @Html.DisplayNameFor(model => model.Local.Outside)
                </label>
            </div>

            <div class="form-group">
                <label asp-for="Local.Coordenadas" class="control-label"></label>
                <input asp-for="Local.Coordenadas" class="form-control" />
                <span asp-validation-for="Local.Coordenadas" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Criar Local" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Voltar à Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
