@page
@model festas_da_aldeia_pages.Pages.LocalPages.CreateModel

@{
    ViewData["Title"] = "Adicionar Local";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        
        <div class="mb-4">
            <a asp-page="./Index" class="back-link">
                <i class="bi bi-arrow-left"></i> Voltar à Lista
            </a>
        </div>

        <div class="page-header-container">
            <h1 class="page-title-gradient mb-1">Adicionar Novo Local</h1>
            <p class="text-muted mb-0">Registe um espaço para a realização de eventos nas festas.</p>
        </div>

        <div class="form-card">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>Por favor, corrija os erros assinalados abaixo.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Local.Nome" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Local.Nome) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt-fill text-muted"></i></span>
                        <input asp-for="Local.Nome" class="form-control form-control-custom border-start-0 ps-0" placeholder="Ex: Largo da Igreja, Salão Paroquial..." aria-required="true" />
                    </div>
                    <span asp-validation-for="Local.Nome" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Local.Descricao" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Local.Descricao)
                    </label>
                    <textarea asp-for="Local.Descricao" class="form-control form-control-custom" rows="4" placeholder="Descreva brevemente as características do local, capacidade, etc..."></textarea>
                    <span asp-validation-for="Local.Descricao" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="form-switch-custom mb-4">
                    <div>
                        <h6 class="fw-bold mb-0">Espaço Exterior?</h6>
                        <span class="text-muted small">Ative se o local for ao ar livre (ex: praça, parque)</span>
                    </div>
                    <div class="form-check form-switch pe-0 mb-0">
                        <input class="form-check-input" type="checkbox" role="switch" asp-for="Local.Outside" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Local.Coordenadas" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Local.Coordenadas)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-map-fill text-muted"></i></span>
                        <input asp-for="Local.Coordenadas" class="form-control form-control-custom border-start-0 ps-0" placeholder="Formato: latitude,longitude ou link do Google Maps" />
                    </div>
                    <div class="form-text text-muted small mt-1">
                        Utilize coordenadas (ex: 39.4795,-8.3014) ou um link para exibir um mapa.
                    </div>
                    <span asp-validation-for="Local.Coordenadas" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end pt-3 border-top mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-check-lg"></i> Adicionar Local
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
