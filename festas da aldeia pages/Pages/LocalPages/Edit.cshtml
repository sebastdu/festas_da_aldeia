@page
@model festas_da_aldeia_pages.Pages.LocalPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Local</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Local.IdLocal" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Local.Nome" class="control-label"></label>
                <input asp-for="Local.Nome" class="form-control" aria-required="true"/>
                <span asp-validation-for="Local.Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Local.Descricao" class="control-label"></label>
                <input asp-for="Local.Descricao" class="form-control" />
                <span asp-validation-for="Local.Descricao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Local.Outside" class="control-label"></label>
                <input asp-for="Local.Outside" class="form-check-input" />
                <span asp-validation-for="Local.Outside" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Local.Coordenadas" class="control-label"></label>
                <input asp-for="Local.Coordenadas" class="form-control" />
                <span asp-validation-for="Local.Coordenadas" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Local.Eventos" class="control-label"></label>
                <input asp-for="Local.Eventos" class="form-control" />
                <span asp-validation-for="Local.Eventos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
