@page
@model festas_da_aldeia_pages.Pages.LocalPages.DeleteModel

@{
    ViewData["Title"] = "Eliminar Local";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        
        <div class="mb-4">
            <a asp-page="./Index" class="back-link">
                <i class="bi bi-arrow-left"></i> Voltar aos Locais
            </a>
        </div>

        <div class="page-header-container">
            <h1 class="page-title-gradient mb-1">Eliminar Local</h1>
            <p class="text-muted mb-0">Tem a certeza de que pretende remover este registo de local?</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill me-2" style="font-size: 1.25rem;"></i>
                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
        }

        <div class="delete-alert-box mb-4">
            <div class="delete-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1">Aviso de Ação Irreversível</h5>
                <p class="mb-0 small">Esta operação apagará permanentemente o local da base de dados. Esta ação não poderá ser desfeita.</p>
            </div>
        </div>

        <div class="info-sheet mb-4">
            <h4 class="fw-bold text-dark mb-4"><i class="bi bi-geo-alt text-primary me-2"></i>@Model.Local.Nome</h4>

            <div class="info-item pt-0">
                <div class="info-label">Nome do Recinto</div>
                <div class="info-value">@Model.Local.Nome</div>
            </div>

            <div class="info-item">
                <div class="info-label">Tipo de Recinto</div>
                <div class="info-value">
                    <span class="badge-custom @(Model.Local.Outside ? "badge-outdoor" : "badge-indoor")">
                        <i class="bi @(Model.Local.Outside ? "bi-sun-fill" : "bi-door-closed-fill")"></i>
                        @(Model.Local.Outside ? "Exterior" : "Interior")
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Local.Descricao))
            {
                <div class="info-item pb-0">
                    <div class="info-label">Descrição</div>
                    <div class="info-value text-secondary">@Model.Local.Descricao</div>
                </div>
            }
        </div>

        <div class="form-card py-3">
            <form method="post">
                <input type="hidden" asp-for="Local.IdLocal" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                        Cancelar e Voltar
                    </a>
                    <button type="submit" class="btn btn-danger-custom px-4">
                        <i class="bi bi-trash-fill"></i> Sim, Eliminar Local
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
