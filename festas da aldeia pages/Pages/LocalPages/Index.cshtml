@page
@model festas_da_aldeia_pages.Pages.LocalPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Local[0].Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Local[0].Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Local[0].Outside)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Local[0].Coordenadas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Local[0].Eventos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Local) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(model => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(model => item.Outside)
            </td>
            <td>
                @Html.DisplayFor(model => item.Coordenadas)
            </td>
            <td>
                @Html.DisplayFor(model => item.Eventos)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.IdLocal">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.IdLocal">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.IdLocal">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
