@page
@model festas_da_aldeia_pages.Pages.ArtistaPages.IndexModel

@{
    ViewData["Title"] = "Artistas";
}

<div class="page-header-container mb-3">
    <h1 class="page-title-gradient mb-1"><i class="bi bi-people me-2"></i>Artistas</h1>
    <p class="text-muted mb-0" style="font-size:0.95rem;">Conheça os artistas do programa de atuações</p>
</div>

@* ── PESQUISA ── *@
<form method="get" class="mb-3">
    <input type="hidden" name="Ordem" value="@Model.Ordem" />
    <div class="cartaz-search-wrapper">
        <i class="bi bi-search cartaz-search-icon"></i>
        <input type="text" name="Pesquisa" value="@Model.Pesquisa"
               class="cartaz-search-input"
               placeholder="Pesquisar artista pelo nome…"
               autocomplete="off" />
        @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
        {
            <a asp-page="./Index" asp-route-Ordem="@Model.Ordem" class="cartaz-search-clear" title="Limpar">
                <i class="bi bi-x-lg"></i>
            </a>
        }
        <button type="submit" class="cartaz-search-btn">Pesquisar</button>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
    {
        <p class="mt-2 mb-0 text-muted" style="font-size:0.85rem;">
            <i class="bi bi-funnel me-1"></i>
            @Model.Artista.Count resultado@(Model.Artista.Count != 1 ? "s" : "") para
            "<strong>@Model.Pesquisa</strong>"
        </p>
    }
</form>

@* ── ORDENAÇÃO ── *@
<div class="d-flex align-items-center gap-2 mb-4 flex-wrap">
    <span class="text-muted" style="font-size:0.85rem;font-weight:600;">Ordenar:</span>
    @foreach (var (val, label, icon) in new[] {
        ("az",    "A → Z",          "bi-sort-alpha-down"),
        ("za",    "Z → A",          "bi-sort-alpha-up"),
        ("mais",  "Mais atuações",  "bi-sort-numeric-down-alt"),
        ("menos", "Menos atuações", "bi-sort-numeric-down"),
    })
    {
        var ativo = (Model.Ordem ?? "az") == val;
        <a asp-page="./Index" asp-route-Ordem="@val" asp-route-Pesquisa="@Model.Pesquisa"
               class="artista-ordem-btn @(ativo ? "ativo" : "")">
            <i class="bi @icon me-1"></i>@label
        </a>
    }
</div>

@* ── GRELHA ── *@
@if (!Model.Artista.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people" style="font-size:3rem; opacity:0.3;"></i>
        <p class="mt-3">
            @if (!string.IsNullOrWhiteSpace(Model.Pesquisa))
            {
                <text>Nenhum artista encontrado para "<strong>@Model.Pesquisa</strong>".</text>
            }
            else
            {

                <text>Ainda não existem artistas registados.</text>
            }
        </p>
    </div>
}
else
{
    <div class="artistas-grid">
        @foreach (var item in Model.Artista)
        {
            var fotoUrl = item.LinkFotoPerfil;
            if (!string.IsNullOrEmpty(fotoUrl) && !fotoUrl.StartsWith("http://") && !fotoUrl.StartsWith("https://"))
                fotoUrl = "https://" + fotoUrl;

            var detailsUrl = Url.Page("./Details", new { id = item.IdArtista });

            <div class="artista-banner">
                <a href="@detailsUrl" class="artista-banner-link" aria-label="Ver @item.Nome"></a>

                <div class="artista-banner-foto">
                    @if (!string.IsNullOrEmpty(fotoUrl))
                    {
                        <img src="@fotoUrl" alt="@item.Nome"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                        <div class="artista-banner-foto-fallback" style="display:none;">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                    else
                    {
                        <div class="artista-banner-foto-fallback">
                            <i class="bi bi-person"></i>
                        </div>
                    }
                </div>

                <div class="artista-banner-body">
                    <h5 class="artista-banner-nome">@item.Nome</h5>
                    @if (item.Cartazes.Any())
                    {
                        <span class="artista-banner-atuacoes">
                            <i class="bi bi-music-note-list me-1"></i>@item.Cartazes.Count atuaç@(item.Cartazes.Count == 1 ? "ão" : "ões")
                        </span>
                    }
                </div>
            </div>
        }
    </div>
}

@* ── PAGINAÇÃO ── *@
@{
    ViewData["PaginaAtual"] = Model.Pagina;
    ViewData["TotalPaginas"] = Model.TotalPaginas;
    ViewData["TotalItens"] = Model.TotalItens;
    ViewData["RouteValues"] = new Dictionary<string, string> { ["Ordem"] = Model.Ordem ?? "", ["Pesquisa"] = Model.Pesquisa ?? "" };
}
<partial name="_Paginacao" />
