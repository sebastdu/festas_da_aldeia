@page
@model festas_da_aldeia_pages.Pages.ArtistaPages.IndexModel

@{
    ViewData["Title"] = "Artistas";
}

<div class="page-header-container d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="page-title-gradient mb-1"><i class="bi bi-people me-2"></i>Artistas</h1>
        <p class="text-muted mb-0" style="font-size:0.95rem;">Gerir os artistas do programa de atuações</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">
        <i class="bi bi-plus-lg"></i> Novo Artista
    </a>
</div>

@if (!Model.Artista.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-people" style="font-size:3rem; opacity:0.3;"></i>
        <p class="mt-3">Ainda não existem artistas registados.</p>
        <a asp-page="Create" class="btn btn-primary mt-2"><i class="bi bi-plus-lg"></i> Adicionar primeiro artista</a>
    </div>
}
else
{
    <div class="table-custom-wrapper">
        <table class="table table-custom table-hover mb-0">
            <thead>
                <tr>
                    <th><i class="bi bi-person me-1"></i>Nome Artístico</th>
                    <th><i class="bi bi-chat-text me-1"></i>Biografia</th>
                    <th><i class="bi bi-telephone me-1"></i>Contacto</th>
                    <th><i class="bi bi-image me-1"></i>Foto de Perfil</th>
                    <th class="text-center">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Artista)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrEmpty(item.LinkFotoPerfil))
                                {
                                    var avatarUrl = item.LinkFotoPerfil;
                                    if (!avatarUrl.StartsWith("http://") && !avatarUrl.StartsWith("https://"))
                                        avatarUrl = "https://" + avatarUrl;
                                    <img src="@avatarUrl" alt="@item.Nome"
                                         style="width:36px;height:36px;border-radius:50%;object-fit:cover;border:2px solid var(--border-light);"
                                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                    <span class="d-none align-items-center justify-content-center"
                                          style="width:36px;height:36px;border-radius:50%;background:rgba(99,102,241,0.1);color:var(--primary-color);font-size:1rem;">
                                        <i class="bi bi-person"></i>
                                    </span>
                                }
                                else
                                {
                                    <span class="d-flex align-items-center justify-content-center"
                                          style="width:36px;height:36px;border-radius:50%;background:rgba(99,102,241,0.1);color:var(--primary-color);font-size:1rem;">
                                        <i class="bi bi-person"></i>
                                    </span>
                                }
                                <span class="fw-semibold">@Html.DisplayFor(m => item.Nome)</span>
                            </div>
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Biografia))
                            {
                                <span title="@item.Biografia" style="cursor:default;">
                                    @(item.Biografia.Length > 60 ? item.Biografia.Substring(0, 60) + "…" : item.Biografia)
                                </span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Contacto))
                            {
                                <span><i class="bi bi-telephone-fill me-1 text-muted" style="font-size:0.8rem;"></i>@Html.DisplayFor(m => item.Contacto)</span>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">—</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.LinkFotoPerfil))
                            {
                                <a href="@item.LinkFotoPerfil" target="_blank" class="text-primary text-decoration-none" style="font-size:0.85rem;">
                                    <i class="bi bi-link-45deg me-1"></i>Ver foto
                                </a>
                            }
                            else
                            {
                                <span class="text-muted fst-italic">—</span>
                            }
                        </td>
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-1">
                                <a asp-page="./Details" asp-route-id="@item.IdArtista"
                                       class="btn-action-sm details" title="Detalhes">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-page="./Edit" asp-route-id="@item.IdArtista"
                                       class="btn-action-sm" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a asp-page="./Delete" asp-route-id="@item.IdArtista"
                                       class="btn-action-sm delete" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
