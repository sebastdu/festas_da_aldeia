@page
@model festas_da_aldeia_pages.Pages.ArtistaPages.DetailsModel
@using System.Globalization

@{
    ViewData["Title"] = Model.Artista.Nome;
    var ptPT = new CultureInfo("pt-PT");

    var fotoUrl = Model.Artista.LinkFotoPerfil;
    if (!string.IsNullOrEmpty(fotoUrl) && !fotoUrl.StartsWith("http://") && !fotoUrl.StartsWith("https://"))
        fotoUrl = "https://" + fotoUrl;

    var iniciais = Model.Artista.Nome is { Length: > 0 } n
        ? string.Concat(n.Split(' ').Take(2).Select(p => p[0].ToString().ToUpper()))
        : "?";
}

<div class="mb-3">
    <a asp-page="./Index" class="back-link d-inline-flex align-items-center gap-1">
        <i class="bi bi-arrow-left"></i> Voltar aos artistas
    </a>
</div>

<div class="row g-4">

    @* ── COLUNA ESQUERDA: PERFIL ── *@
    <div class="col-lg-4 col-md-5">
        <div class="artista-details-card">

            @* Foto *@
            <div class="artista-details-foto">
                @if (!string.IsNullOrEmpty(fotoUrl))
                {
                    <img src="@fotoUrl" alt="@Model.Artista.Nome"
                         onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                    <div class="artista-details-foto-fallback" style="display:none;">@iniciais</div>
                }
                else
                {
                    <div class="artista-details-foto-fallback">@iniciais</div>
                }
            </div>

            @* Nome *@
            <div class="artista-details-body">
                <h2 class="artista-details-nome">@Model.Artista.Nome</h2>

                @if (Model.Artista.Cartazes.Any())
                {
                    <span class="artista-banner-atuacoes mb-3 d-inline-flex">
                        <i class="bi bi-music-note-list me-1"></i>
                        @Model.Artista.Cartazes.Count atuaç@(Model.Artista.Cartazes.Count == 1 ? "ão" : "ões")
                    </span>
                }

                @if (!string.IsNullOrEmpty(Model.Artista.Biografia))
                {
                    <p class="artista-details-bio">@Model.Artista.Biografia</p>
                }
                else
                {
                    <p class="text-muted fst-italic" style="font-size:0.9rem;">Sem biografia disponível.</p>
                }

            </div>
        </div>
    </div>

    @* ── COLUNA DIREITA: ATUAÇÕES ── *@
    <div class="col-lg-8 col-md-7">
        <h4 class="fw-bold mb-3">
            <i class="bi bi-calendar-event me-2 text-primary"></i>Atuações
        </h4>

        @if (!Model.Artista.Cartazes.Any())
        {
            <div class="text-center py-5 text-muted" style="background:var(--card-bg);border:1.5px dashed var(--border-light);border-radius:var(--radius-lg);">
                <i class="bi bi-calendar-x" style="font-size:2.5rem;opacity:0.25;"></i>
                <p class="mt-2 mb-0">Sem atuações programadas.</p>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var cartaz in Model.Artista.Cartazes.OrderBy(c => c.DataHoraAtuacao))
                {
                    var fim = cartaz.DataHoraAtuacao.AddMinutes(cartaz.DuracaoMinutos);
                    var agora = DateTime.Now;
                    var emCurso = cartaz.DataHoraAtuacao <= agora && fim >= agora;
                    var passado = fim < agora;

                    <div class="cartaz-banner @(emCurso ? "cartaz-banner-live" : passado ? "cartaz-banner-past" : "")">
                        <div class="cartaz-banner-data">
                            <span class="cartaz-dia">@cartaz.DataHoraAtuacao.ToString("ddd", ptPT).ToUpper()</span>
                            <span class="cartaz-num">@cartaz.DataHoraAtuacao.Day</span>
                            <span class="cartaz-mes">@cartaz.DataHoraAtuacao.ToString("MMM", ptPT).ToUpper()</span>
                        </div>
                        <div class="cartaz-banner-info">
                            <div class="d-flex align-items-center gap-2 mb-1 flex-wrap">
                                @if (emCurso)
                                {
                                    <span class="badge-live"><i class="bi bi-circle-fill me-1"></i>Em curso</span>
                                }
                                else if (passado)
                                {
                                    <span class="badge-past"><i class="bi bi-check-circle me-1"></i>Concluída</span>
                                }
                                <span class="cartaz-hora">
                                    <i class="bi bi-clock me-1"></i>
                                    @cartaz.DataHoraAtuacao.ToString("HH:mm") — @fim.ToString("HH:mm")
                                    <span class="ms-1 text-muted">(@cartaz.DuracaoMinutos min)</span>
                                </span>
                            </div>
                            @if (cartaz.Evento != null)
                            {
                                <div class="cartaz-evento-nome">@cartaz.Evento.Nome</div>
                                @if (cartaz.Evento.Local != null)
                                {
                                    <div class="cartaz-local">
                                        <i class="bi bi-geo-alt me-1"></i>@cartaz.Evento.Local.Nome
                                        @if (cartaz.Evento.Local.Outside)
                                        {
                                            <span class="badge-exterior ms-1"><i class="bi bi-sun me-1"></i>Exterior</span>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

</div>
