@page
@model festas_da_aldeia_pages.Pages.ArtistaPages.CreateModel

@{
    ViewData["Title"] = "Novo Artista";
}

<div class="page-header-container">
    <a asp-page="./Index" class="back-link mb-3 d-inline-flex">
        <i class="bi bi-arrow-left"></i> Voltar à lista
    </a>
    <h1 class="page-title-gradient mb-1"><i class="bi bi-person-plus me-2"></i>Novo Artista</h1>
    <p class="text-muted mb-0" style="font-size:0.95rem;">Preencha os dados do novo artista</p>
</div>

<div class="row">
    <div class="col-lg-7 col-md-9">
        <div class="form-card">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 d-flex gap-2 align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Artista.Nome" class="form-label-custom">
                        @Html.DisplayNameFor(m => m.Artista.Nome)
                        <span class="text-danger ms-1">*</span>
                    </label>
                    <input asp-for="Artista.Nome" class="form-control form-control-custom" placeholder="Nome artístico" aria-required="true" />
                    <span asp-validation-for="Artista.Nome" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Artista.Biografia" class="form-label-custom">
                        @Html.DisplayNameFor(m => m.Artista.Biografia)
                    </label>
                    <textarea asp-for="Artista.Biografia" class="form-control form-control-custom" rows="4"
                              placeholder="Breve descrição ou biografia do artista..."></textarea>
                    <span asp-validation-for="Artista.Biografia" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Artista.Contacto" class="form-label-custom">
                        @Html.DisplayNameFor(m => m.Artista.Contacto)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="bi bi-telephone text-muted"></i>
                        </span>
                        <input asp-for="Artista.Contacto" class="form-control form-control-custom" placeholder="+351 9XX XXX XXX"
                               style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                    </div>
                    <span asp-validation-for="Artista.Contacto" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Artista.LinkFotoPerfil" class="form-label-custom">
                        @Html.DisplayNameFor(m => m.Artista.LinkFotoPerfil)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0" style="border:1.5px solid var(--border-light);border-right:none;border-radius:var(--radius-sm) 0 0 var(--radius-sm);">
                            <i class="bi bi-image text-muted"></i>
                        </span>
                        <input asp-for="Artista.LinkFotoPerfil" class="form-control form-control-custom" placeholder="https://exemplo.com/foto.jpg"
                               style="border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;" />
                    </div>
                    <span asp-validation-for="Artista.LinkFotoPerfil" class="text-danger small mt-1 d-block"></span>
                    <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i>URL pública para a foto de perfil do artista</small>
                </div>

                <div class="d-flex gap-2">
                    <input type="submit" value="Criar Artista" class="btn btn-primary" />
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
