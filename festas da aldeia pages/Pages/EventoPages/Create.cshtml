@page
@model festas_da_aldeia_pages.Pages.EventoPages.CreateModel

@{
    ViewData["Title"] = "Criar Evento";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        
        <div class="mb-4">
            <a asp-page="./Index" class="back-link">
                <i class="bi bi-arrow-left"></i> Voltar à Lista
            </a>
        </div>

        <div class="page-header-container">
            <h1 class="page-title-gradient mb-1">Adicionar Novo Evento</h1>
            <p class="text-muted mb-0">Registe uma nova atuação ou espetáculo no programa das festas.</p>
        </div>

        <div class="form-card">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <div>Por favor, corrija os erros assinalados abaixo.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="Evento.Nome" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Evento.Nome) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-music-player-fill text-muted"></i></span>
                        <input asp-for="Evento.Nome" class="form-control form-control-custom border-start-0 ps-0" placeholder="Ex: Concerto de Abertura, Rancho Folclórico..." aria-required="true" />
                    </div>
                    <span asp-validation-for="Evento.Nome" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Evento.Descricao" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Evento.Descricao)
                    </label>
                    <textarea asp-for="Evento.Descricao" class="form-control form-control-custom" rows="3" placeholder="Descreva brevemente as atrações do evento..."></textarea>
                    <span asp-validation-for="Evento.Descricao" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-4">
                        <label asp-for="Evento.DataInicio" class="form-label-custom">
                            @Html.DisplayNameFor(model => model.Evento.DataInicio) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-check text-muted"></i></span>
                            <input asp-for="Evento.DataInicio" class="form-control form-control-custom border-start-0 ps-0" aria-required="true" />
                        </div>
                        <span asp-validation-for="Evento.DataInicio" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="Evento.DataFim" class="form-label-custom">
                            @Html.DisplayNameFor(model => model.Evento.DataFim) <span class="text-danger">*</span>
                        </label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0"><i class="bi bi-calendar-x text-muted"></i></span>
                            <input asp-for="Evento.DataFim" class="form-control form-control-custom border-start-0 ps-0" aria-required="true" />
                        </div>
                        <span asp-validation-for="Evento.DataFim" class="text-danger small mt-1 d-block"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Evento.Patrocinador" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Evento.Patrocinador)
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-award-fill text-muted"></i></span>
                        <input asp-for="Evento.Patrocinador" class="form-control form-control-custom border-start-0 ps-0" placeholder="Ex: Município, Marca Local..." />
                    </div>
                    <span asp-validation-for="Evento.Patrocinador" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Evento.IdLocal" class="form-label-custom">
                        @Html.DisplayNameFor(model => model.Evento.IdLocal) <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-geo-alt-fill text-muted"></i></span>
                        <select asp-for="Evento.IdLocal" class="form-select form-control-custom border-start-0 ps-0" asp-items="ViewBag.IdLocal" aria-required="true">
                            <option value="">-- Selecione o recinto --</option>
                        </select>
                    </div>
                    <span asp-validation-for="Evento.IdLocal" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-grid gap-2 d-sm-flex justify-content-sm-end pt-3 border-top mt-4">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                    <button type="submit" class="btn btn-primary px-4">
                        <i class="bi bi-calendar-plus"></i> Agendar Evento
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
