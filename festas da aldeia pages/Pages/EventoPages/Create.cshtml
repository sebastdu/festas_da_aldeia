@page
@model festas_da_aldeia_pages.Pages.EventoPages.CreateModel

@{
    ViewData["Title"] = "Criar Evento";
}

<h1>Criar</h1>

<h4>Evento</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Evento.Nome" class="control-label"></label>
                <input asp-for="Evento.Nome" class="form-control" aria-required="true" />
                <span asp-validation-for="Evento.Nome" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Evento.Descricao" class="control-label"></label>
                <textarea asp-for="Evento.Descricao" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Evento.Descricao" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <span class="text-danger">*</span>
                <label asp-for="Evento.DataInicio" class="control-label"></label>
                <input asp-for="Evento.DataInicio" class="form-control" aria-required="true" />
                <span asp-validation-for="Evento.DataInicio" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <span class="text-danger">*</span>
                <label asp-for="Evento.DataFim" class="control-label"></label>
                <input asp-for="Evento.DataFim" class="form-control" aria-required="true" />
                <span asp-validation-for="Evento.DataFim" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Evento.Patrocinador" class="control-label"></label>
                <input asp-for="Evento.Patrocinador" class="form-control" />
                <span asp-validation-for="Evento.Patrocinador" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <span class="text-danger">*</span>
                <label asp-for="Evento.IdLocal" class="control-label"></label>
                <select asp-for="Evento.IdLocal" class="form-control" asp-items="ViewBag.IdLocal" aria-required="true">
                    <option value="">-- Selecione um Local --</option>
                </select>
                <span asp-validation-for="Evento.IdLocal" class="text-danger"></span>
            </div>

            <div class="form-group mt-4">
                <input type="submit" value="Criar Evento" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-page="./Index">Voltar à Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
