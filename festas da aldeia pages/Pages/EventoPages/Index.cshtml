@page
@model festas_da_aldeia_pages.Pages.EventoPages.IndexModel

@{
    ViewData["Title"] = "Gestão de Eventos";
}

<div class="page-header-container d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
    <div>
        <h1 class="page-title-gradient mb-1"><i class="bi bi-calendar-event me-2"></i>Eventos</h1>
        <p class="text-muted mb-0">Consulte e planeie a agenda de espetáculos e celebrações nas festas.</p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-page="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-calendar-plus"></i> Adicionar Novo Evento
        </a>
    }
</div>

@if (!Model.Evento.Any())
{
    <div class="card-custom text-center py-5">
        <div class="card-body-custom">
            <div class="card-icon-container mx-auto mb-3">
                <i class="bi bi-calendar-x"></i>
            </div>
            <h4 class="fw-bold">Nenhum evento registado</h4>
            <p class="text-muted">Ainda não existem eventos planeados na agenda.</p>
            @if (User.IsInRole("Admin"))
            {
                <a asp-page="Create" class="btn btn-outline-primary mt-2">
                    <i class="bi bi-plus-lg"></i> Criar Primeiro Evento
                </a>
            }
        </div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var item in Model.Evento)
        {
            <div class="col">
                <div class="card h-100 card-custom">
                    <div class="card-body-custom d-flex flex-column h-100 justify-content-between">
                        <div>
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="card-icon-container mb-0">
                                    <i class="bi bi-music-player-fill text-primary"></i>
                                </div>
                                <span class="badge-custom badge-outdoor">
                                    <i class="bi bi-clock"></i>
                                    @((item.DataFim - item.DataInicio).TotalHours.ToString("F0"))h duração
                                </span>
                            </div>

                            <h4 class="card-title fw-bold mb-2">@item.Nome</h4>
                            @if (!string.IsNullOrEmpty(item.Descricao))
                            {
                                <p class="text-muted card-text small mb-3">@item.Descricao</p>
                            }
                            else
                            {

                                <p class="text-muted card-text small fst-italic mb-3">Sem descrição disponível.</p>
                            }
                        </div>

                        <div>
                            <div class="bg-light rounded-3 p-3 border mb-4">
                                <div class="d-flex align-items-center mb-2 small text-dark">
                                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>
                                    <span>
                                        Local:
                                        @if (item.Local != null)
                                        {
                                            <a asp-page="/LocalPages/Details" asp-route-id="@item.IdLocal" class="text-decoration-none fw-semibold">
                                                @item.Local.Nome
                                            </a>
                                        }
                                        else
                                        {

                                            <span class="text-muted">Desconhecido</span>
                                        }
                                    </span>
                                </div>
                                <div class="d-flex align-items-center mb-2 small text-dark">
                                    <i class="bi bi-calendar3 text-primary me-2"></i>
                                    <span>@item.DataInicio.ToString("dd MMM yyyy, HH:mm")</span>
                                </div>
                                @if (!string.IsNullOrEmpty(item.Patrocinador))
                                {
                                    <div class="d-flex align-items-center small text-dark">
                                        <i class="bi bi-award-fill text-warning me-2"></i>
                                        <span>Patrocínio: <strong>@item.Patrocinador</strong></span>
                                    </div>
                                }
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top">
                                <div class="d-flex gap-2">
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-page="./Edit" asp-route-id="@item.IdEvento" class="btn btn-action-sm" title="Editar Evento">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                    <a asp-page="./Details" asp-route-id="@item.IdEvento" class="btn btn-action-sm details" title="Ver Detalhes">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-page="./Delete" asp-route-id="@item.IdEvento" class="btn btn-action-sm delete" title="Eliminar Evento">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ── PAGINAÇÃO ── *@
@{
    ViewData["PaginaAtual"] = Model.Pagina;
    ViewData["TotalPaginas"] = Model.TotalPaginas;
    ViewData["TotalItens"] = Model.TotalItens;
    ViewData["RouteValues"] = new Dictionary<string, string>();
}
<partial name="_Paginacao" />
