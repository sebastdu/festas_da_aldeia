@page
@model festas_da_aldeia_pages.Pages.EventoPages.DeleteModel

@{
    ViewData["Title"] = "Eliminar Evento";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-xl-7">
        
        <div class="mb-4">
            <a asp-page="./Index" class="back-link">
                <i class="bi bi-arrow-left"></i> Voltar à Agenda
            </a>
        </div>

        <div class="page-header-container">
            <h1 class="page-title-gradient mb-1">Eliminar Evento</h1>
            <p class="text-muted mb-0">Tem a certeza de que pretende remover este registo de evento?</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-octagon-fill me-2" style="font-size: 1.25rem;"></i>
                <div asp-validation-summary="ModelOnly" class="mb-0"></div>
            </div>
        }

        <div class="delete-alert-box mb-4">
            <div class="delete-alert-icon">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div>
                <h5 class="fw-bold mb-1">Aviso de Ação Irreversível</h5>
                <p class="mb-0 small">Esta operação apagará permanentemente o evento programado. Os dados associados serão removidos.</p>
            </div>
        </div>

        <div class="info-sheet mb-4">
            <h4 class="fw-bold text-dark mb-4"><i class="bi bi-calendar-x text-primary me-2"></i>@Model.Evento.Nome</h4>

            <div class="info-item pt-0">
                <div class="info-label">Nome do Evento</div>
                <div class="info-value">@Model.Evento.Nome</div>
            </div>

            <div class="info-item">
                <div class="info-label">Horário</div>
                <div class="info-value">
                    <span class="fw-semibold text-secondary">
                        <i class="bi bi-calendar3 me-1"></i>@Model.Evento.DataInicio.ToString("g")
                    </span>
                    <span class="mx-2">até</span>
                    <span class="fw-semibold text-secondary">
                        @Model.Evento.DataFim.ToString("g")
                    </span>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Evento.Patrocinador))
            {
                <div class="info-item">
                    <div class="info-label">Patrocinador</div>
                    <div class="info-value text-secondary">@Model.Evento.Patrocinador</div>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Evento.Descricao))
            {
                <div class="info-item pb-0">
                    <div class="info-label">Descrição</div>
                    <div class="info-value text-secondary">@Model.Evento.Descricao</div>
                </div>
            }
        </div>

        <div class="form-card py-3">
            <form method="post">
                <input type="hidden" asp-for="Evento.IdEvento" />
                <div class="d-flex justify-content-between align-items-center">
                    <a asp-page="./Index" class="btn btn-outline-secondary px-4">
                        Cancelar e Voltar
                    </a>
                    <button type="submit" class="btn btn-danger-custom px-4">
                        <i class="bi bi-trash-fill"></i> Sim, Eliminar Evento
                    </button>
                </div>
            </form>
        </div>

    </div>
</div>
