@page
@model festas_da_aldeia_pages.Pages.CartazPages.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Cartaz</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Cartaz.IdCartaz" />
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Cartaz.DataHoraAtuacao" class="control-label"></label>
                <input asp-for="Cartaz.DataHoraAtuacao" class="form-control" aria-required="true"/>
                <span asp-validation-for="Cartaz.DataHoraAtuacao" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cartaz.DuracaoMinutos" class="control-label"></label>
                <input asp-for="Cartaz.DuracaoMinutos" class="form-control" />
                <span asp-validation-for="Cartaz.DuracaoMinutos" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Cartaz.IdEvento" class="control-label"></label>
                <input asp-for="Cartaz.IdEvento" class="form-control" aria-required="true"/>
