            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Cartaz.IdArtista" class="control-label"></label>
                <input asp-for="Cartaz.IdArtista" class="form-control" aria-required="true"/>
                <span asp-validation-for="Cartaz.IdArtista" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Cartaz.Artista" class="control-label"></label>
                <input asp-for="Cartaz.Artista" class="form-control" />
                <span asp-validation-for="Cartaz.Artista" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
