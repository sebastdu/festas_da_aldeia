            </div>
            <div class="form-group">
                <label asp-for="Cartaz.Evento" class="control-label"></label>
                <input asp-for="Cartaz.Evento" class="form-control" />
                <span asp-validation-for="Cartaz.Evento" class="text-danger"></span>
