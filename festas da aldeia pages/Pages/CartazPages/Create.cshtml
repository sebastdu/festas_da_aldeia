@page
@model festas_da_aldeia_pages.Pages.CartazPages.CreateModel

@{
    ViewData["Title"] = "Nova Atuação";
}

<div class="page-header-container">
    <a asp-page="./Index" class="back-link mb-3 d-inline-flex">
        <i class="bi bi-arrow-left"></i> Voltar à lista
    </a>
    <h1 class="page-title-gradient mb-1"><i class="bi bi-plus-circle me-2"></i>Nova Atuação</h1>
    <p class="text-muted mb-0" style="font-size:0.95rem;">Adicione uma atuação ao programa de cartazes</p>
</div>

<div class="row">
    <div class="col-lg-7 col-md-9">
        <div class="form-card">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-4 d-flex gap-2 align-items-center" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <span></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Cartaz.IdArtista" class="form-label-custom">
                        <i class="bi bi-person me-1"></i>Artista
                        <span class="text-danger ms-1">*</span>
                    </label>
                    <select asp-for="Cartaz.IdArtista" asp-items="Model.ArtistasSelectList"
                            class="form-select form-control-custom" aria-required="true">
                        <option value="">-- Selecionar artista --</option>
                    </select>
                    <span asp-validation-for="Cartaz.IdArtista" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Cartaz.IdEvento" class="form-label-custom">
                        <i class="bi bi-calendar2 me-1"></i>Evento
                        <span class="text-danger ms-1">*</span>
                    </label>
                    <select asp-for="Cartaz.IdEvento" asp-items="Model.EventosSelectList"
                            class="form-select form-control-custom" aria-required="true">
                        <option value="">-- Selecionar evento --</option>
                    </select>
                    <span asp-validation-for="Cartaz.IdEvento" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Cartaz.DataHoraAtuacao" class="form-label-custom">
                        <i class="bi bi-calendar-event me-1"></i>@Html.DisplayNameFor(m => m.Cartaz.DataHoraAtuacao)
                        <span class="text-danger ms-1">*</span>
                    </label>
                    <input asp-for="Cartaz.DataHoraAtuacao" type="datetime-local" class="form-control form-control-custom" aria-required="true" />
                    <span asp-validation-for="Cartaz.DataHoraAtuacao" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="mb-5">
                    <label asp-for="Cartaz.DuracaoMinutos" class="form-label-custom">
                        <i class="bi bi-clock me-1"></i>@Html.DisplayNameFor(m => m.Cartaz.DuracaoMinutos)
                    </label>
                    <div class="input-group">
                        <input asp-for="Cartaz.DuracaoMinutos" type="number" min="1" max="480"
                               class="form-control form-control-custom" placeholder="Ex: 60"
                               style="border-radius:var(--radius-sm) 0 0 var(--radius-sm);" />
                        <span class="input-group-text bg-light" style="border:1.5px solid var(--border-light);border-left:none;border-radius:0 var(--radius-sm) var(--radius-sm) 0;">
                            minutos
                        </span>
                    </div>
                    <span asp-validation-for="Cartaz.DuracaoMinutos" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-2">
                    <input type="submit" value="Criar Atuação" class="btn btn-primary" />
                    <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
