@page
@model festas_da_aldeia_pages.Pages.CartazPages.DeleteModel

@{
    ViewData["Title"] = "Eliminar Atuação";
}

<div class="page-header-container">
    <a asp-page="./Index" class="back-link mb-3 d-inline-flex">
        <i class="bi bi-arrow-left"></i> Voltar à lista
    </a>
    <h1 class="page-title-gradient mb-1"><i class="bi bi-trash me-2"></i>Eliminar Atuação</h1>
</div>

<div class="row">
    <div class="col-lg-7 col-md-9">
        <div class="delete-alert-box mb-4">
            <span class="delete-alert-icon"><i class="bi bi-exclamation-triangle-fill"></i></span>
            <div>
                <strong>Tem a certeza que quer eliminar esta atuação?</strong>
                <div class="mt-1 text-muted" style="font-size:0.9rem;">Esta ação é irreversível.</div>
            </div>
        </div>

        <div class="info-sheet">

            <div class="info-item">
                <div class="info-label"><i class="bi bi-person me-1"></i>Artista</div>
                <div class="info-value">
                    @if (Model.Cartaz.Artista != null)
                    {
                        <span class="fw-semibold">@Model.Cartaz.Artista.Nome</span>
                    }
                    else
                    {

                        <span class="text-muted fst-italic">—</span>
                    }
                </div>
            </div>

            <div class="info-item">
                <div class="info-label"><i class="bi bi-calendar2 me-1"></i>Evento</div>
                <div class="info-value">
                    @if (Model.Cartaz.Evento != null)
                    {
                        <span>@Model.Cartaz.Evento.Nome</span>
                    }
                    else
                    {

                        <span class="text-muted fst-italic">—</span>
                    }
                </div>
            </div>

            <div class="info-item">
                <div class="info-label"><i class="bi bi-calendar-event me-1"></i>@Html.DisplayNameFor(m => m.Cartaz.DataHoraAtuacao)</div>
                <div class="info-value">
                    @Model.Cartaz.DataHoraAtuacao.ToString("dd/MM/yyyy HH:mm")
                </div>
            </div>

            <div class="info-item">
                <div class="info-label"><i class="bi bi-clock me-1"></i>@Html.DisplayNameFor(m => m.Cartaz.DuracaoMinutos)</div>
                <div class="info-value">@Model.Cartaz.DuracaoMinutos minutos</div>
            </div>

        </div>

        <form method="post" class="mt-4">
            <input type="hidden" asp-for="Cartaz.IdCartaz" />
            <div class="d-flex gap-2">
                <input type="submit" value="Confirmar Eliminação" class="btn btn-danger" />
                <a asp-page="./Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</div>
